    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/blog",
      "destination": "/articles",
      "statusCode": 308,
      "regex": "^(?!/_next)/blog(?:/)?$"
    },
    {
      "source": "/blog/:slug",
      "destination": "/articles/:slug",
      "statusCode": 308,
      "regex": "^(?!/_next)/blog(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/contact",
      "destination": "/about",
      "statusCode": 308,
