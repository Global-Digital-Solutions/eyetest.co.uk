9:["$","section",null,{"className":"py-16 sm:py-20 bg-[var(--color-navy)]","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 text-center","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold text-white mb-4","style":{"fontFamily":"var(--font-display)"},"children":"Protect your vision with a regular eye test"}],["$","p",null,{"className":"text-white/70 mb-8 max-w-lg mx-auto","children":"Regular eye tests are the best way to detect problems early. Compare opticians and book online for free."}],["$","$L3",null,{"href":"/search","className":"inline-flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-semibold text-base px-8 py-4 rounded-full transition-all hover:shadow-lg","children":[["$","svg",null,{"className":"w-5 h-5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2.5","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"}]}],"Book an Eye Test"]}]]}]}]
