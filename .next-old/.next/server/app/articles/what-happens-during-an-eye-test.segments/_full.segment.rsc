36:["$","$L11","nhs-vs-private-eye-tests",{"href":"/articles/nhs-vs-private-eye-tests","className":"group card-lift flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden h-full","children":[["$","div",null,{"className":"relative aspect-[16/10] img-zoom","children":[["$","$L18",null,{"src":"/images/elderly-eye-test-sm.jpg","alt":"NHS vs Private Eye Tests: What’s the Difference?","fill":true,"sizes":"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw","className":"object-cover"}],["$","span",null,{"className":"absolute top-3 left-3 text-xs font-medium px-3 py-1 rounded-full backdrop-blur-sm bg-[var(--color-nhs-blue)]/10 text-[var(--color-nhs-blue)]","children":"NHS"}]]}],["$","div",null,{"className":"flex flex-col flex-1 p-5 sm:p-6","children":[["$","h3",null,{"className":"text-base sm:text-lg font-bold text-[var(--color-navy)] group-hover:text-[var(--color-primary)] transition-colors mb-2 line-clamp-2","style":{"fontFamily":"var(--font-display)"},"children":"NHS vs Private Eye Tests: What’s the Difference?"}],["$","p",null,{"className":"text-sm text-gray-500 leading-relaxed mb-4 line-clamp-3","children":"Should you use your free NHS entitlement or pay for a private eye test? Compare what each includes, who qualifies, and which offers better value."}],["$","div",null,{"className":"mt-auto flex items-center justify-between","children":[["$","span",null,{"className":"text-xs text-gray-400","children":"7 min read"}],["$","span",null,{"className":"inline-flex items-center gap-1 text-sm font-medium text-[var(--color-primary)] group-hover:gap-2 transition-all","children":["Read more",["$","svg",null,{"className":"w-4 h-4","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M9 5l7 7-7 7"}]}]]}]]}]]}]]}]
