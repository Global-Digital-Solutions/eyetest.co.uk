1e:["$","div",null,{"className":"prose prose-lg max-w-none text-gray-700 space-y-4 mb-10","children":[["$","p",null,{"children":[["$","strong",null,{"children":"Important:"}],"Age alone does not automatically qualify you for a home visit. A fit and healthy 85-year-old who can get to the high street would not meet the eligibility criteria, whereas a 40-year-old recovering from major surgery would. The determining factor is whether you can reasonably travel to an optician’s practice without assistance."]}],["$","p",null,{"children":"A family member, carer, social worker, or care home manager can arrange a home eye test on someone else’s behalf — you do not need the patient themselves to make the call. No GP referral is required."}]]}]
1f:["$","div",null,{"className":"bg-white rounded-2xl border border-gray-100 p-6 sm:p-8 shadow-sm mb-10","children":[["$","h3",null,{"className":"text-lg font-bold text-[var(--color-navy)] mb-4","style":{"fontFamily":"var(--font-display)"},"children":"Free NHS sight test eligibility (same as in-practice)"}],["$","p",null,{"className":"text-gray-600 mb-4","children":"In addition to qualifying for a home visit, you may also be entitled to a free NHS sight test if you fall into any of these groups:"}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-3","children":[["$","div","Aged 60 or over",{"className":"flex items-start gap-2 text-sm text-gray-700","children":[["$","svg",null,{"className":"w-4 h-4 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"children":"Aged 60 or over"}]]}],["$","div","Aged under 16 (or under 19 in full-time education)",{"className":"flex items-start gap-2 text-sm text-gray-700","children":[["$","svg",null,{"className":"w-4 h-4 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"children":"Aged under 16 (or under 19 in full-time education)"}]]}],["$","div","Diagnosed with diabetes or glaucoma",{"className":"flex items-start gap-2 text-sm text-gray-700","children":[["$","svg",null,{"className":"w-4 h-4 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"children":"Diagnosed with diabetes or glaucoma"}]]}],["$","div","Aged 40+ with a close relative diagnosed with glaucoma",{"className":"flex items-start gap-2 text-sm text-gray-700","children":[["$","svg",null,{"className":"w-4 h-4 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"children":"Aged 40+ with a close relative diagnosed with glaucoma"}]]}],["$","div","Registered blind or partially sighted",{"className":"flex items-start gap-2 text-sm text-gray-700","children":[["$","svg",null,{"className":"w-4 h-4 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"children":"Registered blind or partially sighted"}]]}],["$","div","Receiving Income Support, Universal Credit, Pension Credit Guarantee, or Employment and Support Allowance",{"className":"flex items-start gap-2 text-sm text-gray-700","children":[["$","svg",null,{"className":"w-4 h-4 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"children":"Receiving Income Support, Universal Credit, Pension Credit Guarantee, or Employment and Support Allowance"}]]}],["$","div","Named on a valid NHS tax credit exemption certificate (HC2/HC3)",{"className":"flex items-start gap-2 text-sm text-gray-700","children":["$L4e","$L4f"]}],"$L50"]}]]}]
20:["$","div",null,{"className":"bg-[var(--color-primary)]/5 border border-[var(--color-primary)]/20 rounded-2xl p-6 shadow-sm","children":["$","div",null,{"className":"flex items-start gap-3","children":[["$","div",null,{"className":"w-8 h-8 rounded-full bg-[var(--color-primary)]/10 flex items-center justify-center shrink-0 mt-0.5","children":["$","svg",null,{"className":"w-4 h-4 text-[var(--color-primary)]","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"}]}]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-[var(--color-navy)] mb-1","children":"Scotland: universal free eye tests"}],["$","p",null,{"className":"text-sm text-gray-700","children":"If you live in Scotland, all NHS sight tests are free regardless of age or income. This applies to domiciliary (home visit) eye tests too, provided you meet the mobility criteria for a home visit."}]]}]]}]}]
21:["$","div",null,{"className":"mt-6 prose prose-lg max-w-none text-gray-700","children":["$","p",null,{"children":[["$","strong",null,{"children":"Not eligible for a free home visit?"}]," If you do not meet the NHS criteria but would still prefer to be tested at home, some providers offer private domiciliary eye tests. These typically cost between"," ",["$","strong",null,{"children":"£50 and £60"}]," as a call-out fee, plus the cost of any glasses you choose. This can be a good option for people who value the convenience of a home visit but do not have a medical reason that prevents them from leaving the house."]}]}]
22:["$","div","5",{"className":"flex gap-5 bg-white border border-gray-100 rounded-2xl p-6 shadow-sm","children":[["$","div",null,{"className":"w-12 h-12 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center text-lg font-bold text-[var(--color-primary)] shrink-0","children":5}],["$","div",null,{"children":[["$","h3",null,{"className":"font-semibold text-[var(--color-navy)] mb-2","children":"Choosing your frames"}],["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"If you need new glasses, the optometrist will bring a portable selection of frames for you to try on at home. You can take your time choosing a style you like, with input from family members if you wish. The optometrist will advise on the best lens options for your prescription and lifestyle."}]]}]]}]
23:["$","div","6",{"className":"flex gap-5 bg-white border border-gray-100 rounded-2xl p-6 shadow-sm","children":[["$","div",null,{"className":"w-12 h-12 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center text-lg font-bold text-[var(--color-primary)] shrink-0","children":6}],["$","div",null,{"children":[["$","h3",null,{"className":"font-semibold text-[var(--color-navy)] mb-2","children":"Glasses delivered to your door"}],["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Once you have chosen your frames, the lenses are custom-made in a UK optical laboratory. Your finished glasses are then posted directly to your home, typically within two to three weeks. If any adjustments are needed, the provider will arrange a follow-up visit."}]]}]]}]
24:["$","div",null,{"className":"mt-8 bg-amber-50 border border-amber-200 rounded-2xl p-6","children":["$","div",null,{"className":"flex items-start gap-3","children":[["$","svg",null,{"className":"w-6 h-6 text-amber-500 shrink-0 mt-0.5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"}]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-amber-800 mb-1","children":"If a problem is detected"}],["$","p",null,{"className":"text-sm text-amber-700","children":"If the optometrist finds any signs of an eye condition that needs further investigation — such as cataracts, glaucoma, macular degeneration, or diabetic eye changes — they will write a referral to your GP or directly to the hospital eye service. Urgent conditions can be referred the same day."}]]}]]}]}]
25:["$","p",null,{"className":"text-sm text-gray-600","children":"With the patient’s consent, test results and any recommendations can be shared with care home staff and the resident’s GP. This ensures everyone involved in their care is aware of any eye health issues or changes."}]
26:["$","div","Easy booking for care managers",{"className":"bg-white border border-gray-100 rounded-2xl p-6 shadow-sm","children":[["$","div",null,{"className":"w-10 h-10 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center mb-4","children":["$","svg",null,{"className":"w-5 h-5 text-[var(--color-primary)]","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"1.5","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"}]}]}],["$","h3",null,{"className":"font-semibold text-[var(--color-navy)] mb-2","children":"Easy booking for care managers"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Care home managers can arrange visits for all residents with a single phone call or online booking. The provider handles all scheduling and will work around the care home’s routine to minimise disruption."}]]}]
27:["$","div",null,{"className":"prose prose-lg max-w-none text-gray-700","children":["$","p",null,{"children":"Good vision is closely linked to quality of life in care settings. Research shows that undiagnosed sight problems in care home residents are associated with an increased risk of falls, social withdrawal, and reduced independence. Regular eye tests can help identify issues early and ensure residents have the right glasses, contributing to their comfort, safety, and wellbeing."}]}]
28:["$","div",null,{"className":"text-xs text-gray-500 mt-1","children":"Single-vision, low prescription"}]
29:["$","div","B",{"className":"bg-gray-50 rounded-xl p-4 text-center","children":[["$","div",null,{"className":"text-xs font-medium text-gray-500 mb-1","children":["Band ","B"]}],["$","div",null,{"className":"text-xl font-bold text-[var(--color-primary)]","children":"£67.40"}],["$","div",null,{"className":"text-xs text-gray-500 mt-1","children":"Single-vision, higher prescription"}]]}]
