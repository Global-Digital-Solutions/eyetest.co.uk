2b:["$","div","D",{"className":"bg-gray-50 rounded-xl p-4 text-center","children":[["$","div",null,{"className":"text-xs font-medium text-gray-500 mb-1","children":["Band ","D"]}],["$","div",null,{"className":"text-xl font-bold text-[var(--color-primary)]","children":"£215.50"}],["$","div",null,{"className":"text-xs text-gray-500 mt-1","children":"Complex or high-powered lenses"}]]}]
2c:["$","div",null,{"className":"prose prose-lg max-w-none text-gray-700","children":["$","p",null,{"children":"Reputable home visit providers do not charge hidden fees or call-out charges for NHS-eligible patients. If you are unsure whether you qualify for free NHS eye care, speak to the provider when you book — they will be able to confirm your eligibility over the phone."}]}]
2d:["$","div","Family and carers can be present",{"className":"bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow","children":[["$","div",null,{"className":"w-12 h-12 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center text-[var(--color-primary)] mb-4","children":["$","svg",null,{"className":"w-7 h-7","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"1.5","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"}]}]}],["$","h3",null,{"className":"font-semibold text-[var(--color-navy)] mb-2","children":"Family and carers can be present"}],["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Loved ones can sit in during the test, ask questions, and help remember the advice given. This can be reassuring for everyone involved."}]]}]
2e:["$","div","Same clinical quality as in-practice",{"className":"bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow","children":[["$","div",null,{"className":"w-12 h-12 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center text-[var(--color-primary)] mb-4","children":["$","svg",null,{"className":"w-7 h-7","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"1.5","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"}]}]}],["$","h3",null,{"className":"font-semibold text-[var(--color-navy)] mb-2","children":"Same clinical quality as in-practice"}],["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"The test is carried out by a fully qualified, GOC-registered optometrist using professional portable equipment. The clinical standard is identical to a high-street eye test."}]]}]
2f:["$","div","Glasses delivered to your door",{"className":"bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow","children":[["$","div",null,{"className":"w-12 h-12 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center text-[var(--color-primary)] mb-4","children":["$","svg",null,{"className":"w-7 h-7","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"1.5","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"}]}]}],["$","h3",null,{"className":"font-semibold text-[var(--color-navy)] mb-2","children":"Glasses delivered to your door"}],["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"After choosing frames during your visit, your custom-made glasses are manufactured in a UK laboratory and posted directly to your home — no second trip needed."}]]}]
30:["$","details","Can someone else arrange a home eye test for me?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"Can someone else arrange a home eye test for me?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"Absolutely. A family member, friend, carer, social worker, GP, or care home manager can arrange a home eye test on your behalf. This is very common — many home visits are booked by relatives who are concerned about a loved one's eyesight. The person booking simply needs to provide basic details such as name, address, and any relevant health information."}]]}]
31:["$","details","What if I need new glasses after my home eye test?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"What if I need new glasses after my home eye test?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"If your prescription has changed or you need glasses for the first time, the optometrist will help you choose frames from a portable selection during your visit. You can try on different styles at home in your own time. Once you have chosen, the lenses are made up in a UK laboratory and the finished glasses are posted directly to your door — usually within two to three weeks. If you are eligible for an NHS optical voucher, this will be applied to reduce the cost."}]]}]
32:["$","details","How often can I have a free NHS home eye test?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"How often can I have a free NHS home eye test?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"The NHS recommends a sight test every two years for most adults, but your optometrist may recommend more frequent checks depending on your circumstances. People with diabetes, glaucoma, or other eye conditions may need annual tests. There is no strict limit on how often you can have a free NHS home eye test, provided you meet the eligibility criteria and your optometrist considers the test clinically necessary."}]]}]
33:["$","details","Can I have an at-home eye test if I live in a care home?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"Can I have an at-home eye test if I live in a care home?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"Yes. Domiciliary opticians regularly visit residential care homes, nursing homes, and supported living facilities across the UK. Care home managers can arrange visits for multiple residents at once. Each resident receives an individual eye test, and results can be shared with the care home staff and GP with the patient's consent. Providers such as OutsideClinic and Specsavers Home Visits offer dedicated care home visiting programmes."}]]}]
34:["$","details","What equipment does the optometrist bring?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"What equipment does the optometrist bring?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"The optometrist brings a full set of portable diagnostic equipment, including a trial lens set or portable phoropter for measuring your prescription, a retinoscope, a direct ophthalmoscope for examining the back of your eye, a handheld slit lamp for detailed eye examination, a tonometer for measuring eye pressure (glaucoma screening), a visual acuity chart, and an ophthalmoscopy lens. All equipment is cleaned and sterilised between patients."}]]}]
35:["$","details","Do I need to prepare anything for the visit?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"Do I need to prepare anything for the visit?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"Very little preparation is needed. It helps to have a well-lit room available with a comfortable chair and enough space for the optometrist to set up. Have your current glasses or contact lenses to hand, along with a list of any medications you are taking. If you have a previous prescription or NHS exemption documentation, keep that accessible too. The optometrist will bring everything else they need."}]]}]
36:["$","details","What happens if the optometrist finds a problem?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"What happens if the optometrist finds a problem?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"If the optometrist detects any signs of an eye condition that needs further investigation — such as cataracts, glaucoma, macular degeneration, or diabetic eye changes — they will write a referral letter to your GP or directly to the hospital eye service. They will explain their findings clearly and discuss next steps with you and anyone else present, such as a family member or carer. Urgent conditions can be referred as an emergency on the same day."}]]}]
37:["$","details","Can I have a contact lens fitting at home?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"Can I have a contact lens fitting at home?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"Some domiciliary opticians offer contact lens assessments and fittings during home visits, but this service is less widely available than standard sight tests. Contact lens fittings require additional equipment and a follow-up appointment, so it is worth asking your chosen provider whether they offer this service when you book. If not, they may be able to refer you to a local practice that does."}]]}]
38:["$","details","Are at-home eye tests available at weekends?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"Are at-home eye tests available at weekends?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"Availability varies by provider and region. Some domiciliary opticians offer Saturday appointments, and a smaller number offer Sunday visits. OutsideClinic and several independent providers offer weekend slots in many areas. It is best to ask about weekend availability when you book, as these appointments tend to fill up quickly. Weekday appointments are generally easier to arrange at short notice."}]]}]
