7:["$","section",null,{"id":"request-home-test","className":"py-16 sm:py-20 bg-gray-50 scroll-mt-24","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4","children":[["$","div",null,{"className":"text-center mb-10","children":[["$","div",null,{"className":"inline-flex items-center gap-2 bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-semibold px-4 py-1.5 rounded-full mb-4 uppercase tracking-wider","children":[["$","svg",null,{"className":"w-4 h-4","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"}]}],"Free for NHS-eligible patients"]}],["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold text-[var(--color-navy)] mb-3","style":{"fontFamily":"var(--font-display)"},"children":"Request an at-home eye test"}],["$","p",null,{"className":"text-gray-600 max-w-xl mx-auto","children":"Complete the form below and our team will match you with the most suitable at-home eye care provider in your area. No GP referral needed — we handle everything for you."}]]}],["$","$L19",null,{}],["$","p",null,{"className":"text-center text-xs text-gray-400 mt-6","children":"Our team reviews every enquiry and connects you with a qualified, GOC-registered domiciliary optometrist in your area."}]]}]}]
8:["$","section",null,{"className":"py-16 sm:py-20","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold text-[var(--color-navy)] mb-6","style":{"fontFamily":"var(--font-display)"},"children":"What is an at-home eye test?"}],["$","div",null,{"className":"prose prose-lg max-w-none text-gray-700 space-y-4","children":[["$","p",null,{"children":["An at-home eye test — also known as a"," ",["$","strong",null,{"children":"domiciliary eye test"}]," or"," ",["$","strong",null,{"children":"home visit eye test"}],"— is a full NHS sight test carried out in your own home by a qualified, GOC-registered (General Optical Council) optometrist. It is exactly the same standard of examination you would receive at a high-street optician, but delivered in the comfort and familiarity of your living room, bedroom, or care home."]}],["$","p",null,{"children":"Domiciliary eye care has been part of the NHS since its earliest days, recognising that not everyone can travel to an optician’s practice. Today, thousands of people across the UK benefit from home eye tests every year, from elderly residents in care homes to younger people recovering from surgery or living with conditions that make leaving the house difficult."}],["$","p",null,{"children":"The visiting optometrist brings a complete set of professional, portable diagnostic equipment. This typically includes:"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2 text-gray-700","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Trial lens set or portable phoropter"}],"— for measuring your prescription accurately"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Retinoscope"}],"— a handheld instrument that shines a light into the eye to objectively measure refractive error"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Direct ophthalmoscope"}],"— used to examine the retina, optic nerve, and blood vessels at the back of your eye"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Handheld slit lamp"}],"— provides a magnified, detailed view of the front of your eye, including the cornea, iris, and lens"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Tonometer"}],"— measures the pressure inside your eye, an important screening test for glaucoma"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Visual acuity chart"}],"— the familiar letter chart used to measure how clearly you can see at different distances"]}]]}],["$","p",null,{"children":"The entire examination is thorough and unhurried. Because the optometrist is visiting you at home, they often have more time to discuss your results, answer questions, and address any concerns you or your family may have. If you need new glasses, you can choose frames from a portable selection during the same visit, and your finished glasses will be delivered directly to your door."}]]}]]}]}]
