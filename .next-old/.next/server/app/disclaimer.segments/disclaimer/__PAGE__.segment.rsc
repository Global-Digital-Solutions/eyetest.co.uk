4:["$","p",null,{"className":"text-gray-600 leading-relaxed mb-4","children":"No content on this Site should be relied upon as a substitute for professional medical advice, diagnosis, or treatment. The information on this Site does not cover all possible uses, directions, precautions, drug interactions, or adverse effects, and should not be used to diagnose or treat any eye condition or disease without the guidance of a qualified professional."}]
5:["$","p",null,{"className":"text-gray-600 leading-relaxed","children":"If you think you may have a medical emergency involving your eyes or vision, call your doctor, go to your nearest Accident and Emergency department, or call 999 immediately."}]
6:["$","div",null,{"className":"mb-10","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-[var(--color-navy)] mb-4 font-[family-name:var(--font-display)]","children":"2. Consult a Qualified Optometrist"}],["$","p",null,{"className":"text-gray-600 leading-relaxed mb-4","children":"We strongly recommend that you consult with a qualified, registered optometrist or ophthalmologist for any concerns about your eye health or vision. All optometrists and dispensing opticians in the United Kingdom must be registered with the General Optical Council (GOC), the regulatory body for the optical profession."}],["$","p",null,{"className":"text-gray-600 leading-relaxed mb-4","children":"You should seek professional eye care advice:"}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2","children":[["$","li",null,{"children":"Before making any decisions about your eye health or vision based on information found on this Site"}],["$","li",null,{"children":"If you experience any sudden changes in your vision, including flashes, floaters, loss of peripheral vision, or sudden blurred vision"}],["$","li",null,{"children":"If you experience eye pain, redness, swelling, or discharge"}],["$","li",null,{"children":"If you have a family history of eye conditions such as glaucoma, macular degeneration, or retinal detachment"}],["$","li",null,{"children":"If you have a systemic condition that can affect your eyes, such as diabetes, high blood pressure, or autoimmune disorders"}],["$","li",null,{"children":"For routine eye examinations at intervals recommended by your eye care professional (typically every two years for most adults)"}]]}]]}]
7:["$","div",null,{"className":"mb-10","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-[var(--color-navy)] mb-4 font-[family-name:var(--font-display)]","children":"3. Professional Standards and Regulation"}],["$","p",null,{"className":"text-gray-600 leading-relaxed mb-4","children":"The opticians listed on eyetest.co.uk are regulated by the General Optical Council (GOC). The GOC sets standards of practice, conduct, and performance for registrants and ensures they are met. This includes:"}],["$","ul",null,{"className":"list-disc pl-6 text-gray-600 space-y-2 mb-4","children":[["$","li",null,{"children":"Optometrists, who are qualified to examine eyes, test sight, and detect eye disease"}],["$","li",null,{"children":"Dispensing opticians, who are qualified to fit and supply optical appliances"}],["$","li",null,{"children":"Student optometrists and student dispensing opticians who are training under supervision"}]]}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":["You can verify that an optometrist or dispensing optician is registered with the GOC by visiting"," ",["$","a",null,{"href":"https://www.optical.org","target":"_blank","rel":"noopener noreferrer","className":"text-[var(--color-primary)] hover:underline","children":"optical.org"}],". We encourage you to check the registration of any practitioner before receiving care."]}]]}]
