3:T908,{"@context":"https://schema.org","@type":"MedicalCondition","name":"Astigmatism","description":"Astigmatism is a very common refractive error caused by an irregularly shaped cornea or lens, which prevents light from focusing evenly on the retina. Instead of being round like a football, the eye is shaped more like a rugby ball, causing vision to be blurred or distorted at all distances. Most people have some degree of astigmatism, and it is easily corrected with glasses, contact lenses, or laser eye surgery.","url":"https://www.eyetest.co.uk/eye-health/conditions/astigmatism","signOrSymptom":[{"@type":"MedicalSymptom","name":"Blurred or distorted vision at both distance and near"},{"@type":"MedicalSymptom","name":"Difficulty seeing fine detail, such as small print or distant signs"},{"@type":"MedicalSymptom","name":"Eye strain and discomfort, especially after prolonged reading or screen use"},{"@type":"MedicalSymptom","name":"Headaches, particularly after visual tasks"},{"@type":"MedicalSymptom","name":"Squinting to try to see more clearly"},{"@type":"MedicalSymptom","name":"Difficulty with night driving due to glare and streaked lights"}],"possibleTreatment":{"@type":"MedicalTherapy","description":"Astigmatism is corrected by using lenses that compensate for the uneven curvature of the eye. Glasses with cylindrical or toric lens elements are the simplest and most common correction. Your prescription will include a cylinder value and an axis number, which describe the amount and direction of th"},"riskFactor":[{"@type":"MedicalRiskFactor","name":"Irregular curvature of the cornea (corneal astigmatism) — the most common cause"},{"@type":"MedicalRiskFactor","name":"Irregular shape of the internal crystalline lens (lenticular astigmatism)"},{"@type":"MedicalRiskFactor","name":"Genetics — astigmatism often runs in families and is usually present from birth"},{"@type":"MedicalRiskFactor","name":"Keratoconus — a progressive thinning and steepening of the cornea"},{"@type":"MedicalRiskFactor","name":"Previous eye surgery or corneal injury"},{"@type":"MedicalRiskFactor","name":"Chalazion (meibomian cyst) pressing on the cornea"}],"author":{"@type":"Organization","name":"eyetest.co.uk","url":"https://www.eyetest.co.uk"},"dateModified":"2026-06-16","lastReviewed":"2026-06-16"}0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$3"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.eyetest.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Eye Health\",\"item\":\"https://www.eyetest.co.uk/eye-health\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Astigmatism\",\"item\":\"https://www.eyetest.co.uk/eye-health/conditions/astigmatism\"}]}"}}],["$","section",null,{"className":"relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 bg-cover bg-center bg-no-repeat","style":{"backgroundImage":"url('https://images.unsplash.com/photo-1766310549795-dd0fc75d499f?auto=format&fit=crop&w=1920&q=80')"}}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-br from-[var(--color-navy)]/92 via-[#112247]/88 to-[var(--color-navy-light)]/92"}],"$L4","$L5","$L6"]}],"$L7","$L8","$L9"]}],"$La"],["$Lb"],"$Lc"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"ssq08EaNRRySny1_GDRUp"}
