11:Ta34,{"@context":"https://schema.org","@type":"MedicalCondition","name":"Conjunctivitis","description":"Conjunctivitis is an inflammation or infection of the conjunctiva — the thin, transparent membrane that covers the white of the eye and lines the inside of the eyelids. It is extremely common in the UK, affecting adults and children alike. Conjunctivitis can be caused by a viral or bacterial infection, an allergic reaction, or an irritant, and while it is usually not serious, it can be uncomfortable and highly contagious in its infective forms.","url":"https://www.eyetest.co.uk/eye-health/conditions/conjunctivitis","signOrSymptom":[{"@type":"MedicalSymptom","name":"Red or pink appearance to the white of one or both eyes"},{"@type":"MedicalSymptom","name":"Watery or mucous discharge from the eye"},{"@type":"MedicalSymptom","name":"Thick yellow or green discharge (more common in bacterial conjunctivitis)"},{"@type":"MedicalSymptom","name":"Itchy, gritty, or burning sensation"},{"@type":"MedicalSymptom","name":"Eyelids stuck together upon waking, especially in the morning"},{"@type":"MedicalSymptom","name":"Swollen eyelids"},{"@type":"MedicalSymptom","name":"Sensitivity to light in some cases"},{"@type":"MedicalSymptom","name":"A feeling that something is in the eye"}],"possibleTreatment":{"@type":"MedicalTherapy","description":"Most cases of infective conjunctivitis are self-limiting and will resolve on their own within one to two weeks without treatment. The NHS advises using clean cotton wool pads soaked in cooled boiled water to gently wipe away any discharge from the eyelids and lashes, cleaning from the inner corner o"},"riskFactor":[{"@type":"MedicalRiskFactor","name":"Viral infection — the most common cause in adults, often associated with a cold or upper respiratory infection"},{"@type":"MedicalRiskFactor","name":"Bacterial infection — more common in children, caused by organisms such as Staphylococcus, Streptococcus, or Haemophilus"},{"@type":"MedicalRiskFactor","name":"Allergic reaction — triggered by pollen (hay fever), dust mites, pet dander, or cosmetics"},{"@type":"MedicalRiskFactor","name":"Irritants such as chlorine from swimming pools, smoke, shampoo, or contact lens solutions"},{"@type":"MedicalRiskFactor","name":"Contact lens overwear or poor lens hygiene"},{"@type":"MedicalRiskFactor","name":"Sexually transmitted infections such as chlamydia or gonorrhoea (less common but important to recognise)"}],"author":{"@type":"Organization","name":"eyetest.co.uk","url":"https://www.eyetest.co.uk"},"dateModified":"2026-06-16","lastReviewed":"2026-06-16"}5:[["$","$L10",null,{}],["$","main",null,{"className":"flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.eyetest.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Eye Health\",\"item\":\"https://www.eyetest.co.uk/eye-health\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Conjunctivitis\",\"item\":\"https://www.eyetest.co.uk/eye-health/conditions/conjunctivitis\"}]}"}}],["$","section",null,{"className":"relative overflow-hidden","children":["$L12","$L13","$L14","$L15","$L16"]}],"$L17","$L18","$L19"]}],"$L1a"]
