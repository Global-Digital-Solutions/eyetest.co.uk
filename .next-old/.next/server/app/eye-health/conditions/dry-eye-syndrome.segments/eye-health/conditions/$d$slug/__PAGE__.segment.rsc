","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"}]}],["$","span",null,{"children":"Ageing and hormonal changes, particularly in post-menopausal women"}]]}],["$","li","Central heating, air conditioning, and dry or windy environments",{"className":"flex items-start gap-3 text-gray-700","children":[["$","svg",null,{"className":"w-5 h-5 text-amber-500 shrink-0 mt-0.5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"}]}],["$","span",null,{"children":"Central heating, air conditioning, and dry or windy environments"}]]}],["$","li","Contact lens wear, especially if lenses are worn for long hours",{"className":"flex items-start gap-3 text-gray-700","children":[["$","svg",null,{"className":"w-5 h-5 text-amber-500 shrink-0 mt-0.5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"}]}],["$","span",null,{"children":"Contact lens wear, especially if lenses are worn for long hours"}]]}],["$","li","Medications including antihistamines, antidepressants, beta-blockers, and the oral contraceptive pill",{"className":"flex items-start gap-3 text-gray-700","children":[["$","svg",null,{"className":"w-5 h-5 text-amber-500 shrink-0 mt-0.5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":"