3:Taf2,{"@context":"https://schema.org","@type":"MedicalCondition","name":"Dry Eye Syndrome","description":"Dry eye syndrome is one of the most common eye conditions in the UK, affecting millions of people. It occurs when your eyes do not produce enough tears, or when the tears evaporate too quickly due to a poor-quality tear film. Despite its name, dry eye can cause watering as well as dryness, along with irritation, grittiness, and tired eyes. It is particularly prevalent among screen users, contact lens wearers, and post-menopausal women.","url":"https://www.eyetest.co.uk/eye-health/conditions/dry-eye-syndrome","signOrSymptom":[{"@type":"MedicalSymptom","name":"Gritty, sandy, or scratchy sensation in the eyes"},{"@type":"MedicalSymptom","name":"Burning or stinging"},{"@type":"MedicalSymptom","name":"Red, irritated eyes"},{"@type":"MedicalSymptom","name":"Excessive watering (a reflex response to surface dryness)"},{"@type":"MedicalSymptom","name":"Blurred vision that clears temporarily when you blink"},{"@type":"MedicalSymptom","name":"Tired or heavy-feeling eyes, especially later in the day"},{"@type":"MedicalSymptom","name":"Sensitivity to wind, air conditioning, or central heating"},{"@type":"MedicalSymptom","name":"Discomfort with contact lens wear"}],"possibleTreatment":{"@type":"MedicalTherapy","description":"For most people with mild to moderate dry eye, management begins with over-the-counter lubricating eye drops (artificial tears). Preservative-free drops are recommended for frequent use, as preservatives can irritate the eye surface over time. Your pharmacist or optometrist can recommend the most su"},"riskFactor":[{"@type":"MedicalRiskFactor","name":"Meibomian gland dysfunction (MGD) — the most common cause, where the oil-producing glands in the eyelids become blocked"},{"@type":"MedicalRiskFactor","name":"Prolonged screen use — reduced blink rate leads to faster tear evaporation"},{"@type":"MedicalRiskFactor","name":"Ageing and hormonal changes, particularly in post-menopausal women"},{"@type":"MedicalRiskFactor","name":"Central heating, air conditioning, and dry or windy environments"},{"@type":"MedicalRiskFactor","name":"Contact lens wear, especially if lenses are worn for long hours"},{"@type":"MedicalRiskFactor","name":"Medications including antihistamines, antidepressants, beta-blockers, and the oral contraceptive pill"},{"@type":"MedicalRiskFactor","name":"Autoimmune conditions such as Sjogren's syndrome, rheumatoid arthritis, and lupus"},{"@type":"MedicalRiskFactor","name":"Previous laser eye surgery (LASIK/LASEK)"},{"@type":"MedicalRiskFactor","name":"Blepharitis (eyelid inflammation)"}],"author":{"@type":"Organization","name":"eyetest.co.uk","url":"https://www.eyetest.co.uk"},"dateModified":"2026-06-16","lastReviewed":"2026-06-16"}0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$3"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.eyetest.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Eye Health\",\"item\":\"https://www.eyetest.co.uk/eye-health\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Dry Eye Syndrome\",\"item\":\"https://www.eyetest.co.uk/eye-health/conditions/dry-eye-syndrome\"}]}"}}],"$L4","$L5","$L6","$L7"]}],"$L8"],["$L9"],"$La"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"ssq08EaNRRySny1_GDRUp"}
