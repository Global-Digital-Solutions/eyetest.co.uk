3:Tacd,{"@context":"https://schema.org","@type":"MedicalCondition","name":"Strabismus (Squint)","description":"Strabismus, commonly known as a squint or crossed eyes, is a condition in which the eyes do not align properly — one eye may turn inward, outward, upward, or downward while the other looks straight ahead. Squint is relatively common in children, affecting approximately 2-3% of the UK population. If left untreated in childhood, it can lead to amblyopia (lazy eye) and permanent loss of binocular vision. However, squint can also develop in adults, sometimes as a sign of an underlying condition requiring investigation.","url":"https://www.eyetest.co.uk/eye-health/conditions/strabismus","signOrSymptom":[{"@type":"MedicalSymptom","name":"One eye turning inward (convergent or esotropia), outward (divergent or exotropia), upward, or downward"},{"@type":"MedicalSymptom","name":"The turn may be constant or intermittent — appearing only when the child is tired, unwell, or focusing at near distances"},{"@type":"MedicalSymptom","name":"Double vision (more common in adults who develop a new squint)"},{"@type":"MedicalSymptom","name":"Closing or covering one eye in bright sunlight or when concentrating"},{"@type":"MedicalSymptom","name":"Abnormal head posture — tilting or turning the head to compensate"},{"@type":"MedicalSymptom","name":"In children: poor depth perception and difficulty with hand-eye coordination"},{"@type":"MedicalSymptom","name":"An infant whose eyes are not straight after 3 months of age"}],"possibleTreatment":{"@type":"MedicalTherapy","description":"Treatment for childhood squint depends on the cause and severity and should begin as early as possible for the best outcome. If an uncorrected refractive error is contributing, glasses are the first step — in many cases of accommodative esotropia (where hyperopia is pulling the eyes inward), glasses"},"riskFactor":[{"@type":"MedicalRiskFactor","name":"Imbalance in the muscles controlling eye movement"},{"@type":"MedicalRiskFactor","name":"Uncorrected refractive error, particularly hyperopia (long-sightedness) — the effort of focusing can trigger the eyes to turn inward"},{"@type":"MedicalRiskFactor","name":"Family history of squint or amblyopia"},{"@type":"MedicalRiskFactor","name":"Premature birth or low birth weight"},{"@type":"MedicalRiskFactor","name":"Conditions affecting the brain or nerves controlling eye muscles — such as cerebral palsy, Down syndrome, or head injury"},{"@type":"MedicalRiskFactor","name":"In adults: cranial nerve palsy, stroke, thyroid eye disease, diabetes, or myasthenia gravis"}],"author":{"@type":"Organization","name":"eyetest.co.uk","url":"https://www.eyetest.co.uk"},"dateModified":"2026-06-16","lastReviewed":"2026-06-16"}0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$3"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.eyetest.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Eye Health\",\"item\":\"https://www.eyetest.co.uk/eye-health\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Strabismus (Squint)\",\"item\":\"https://www.eyetest.co.uk/eye-health/conditions/strabismus\"}]}"}}],"$L4","$L5","$L6","$L7"]}],"$L8"],["$L9"],"$La"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"ssq08EaNRRySny1_GDRUp"}
