3:T59a,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a contact lens fitting & check-up?","acceptedAnswer":{"@type":"Answer","text":"A specialist appointment to fit, assess, or review your contact lenses for comfort, safety, and clear vision."}},{"@type":"Question","name":"How long does a contact lens fitting & check-up take?","acceptedAnswer":{"@type":"Answer","text":"A contact lens fitting & check-up typically takes 30–60 minutes for a first fitting; 15–30 minutes for a routine check-up."}},{"@type":"Question","name":"How much does a contact lens fitting & check-up cost?","acceptedAnswer":{"@type":"Answer","text":"£30–£60 for a fitting; check-ups often included in monthly lens plans (typically £15–£40 per month). Not covered by the NHS unless clinically necessary"}},{"@type":"Question","name":"How often should I have a contact lens fitting & check-up?","acceptedAnswer":{"@type":"Answer","text":"At least once a year; every 6 months for some lens types or if recommended by your optician"}},{"@type":"Question","name":"Is a contact lens fitting & check-up available on the NHS?","acceptedAnswer":{"@type":"Answer","text":"A contact lens fitting & check-up is not routinely funded by the NHS and is typically available as a private service. Some opticians may include elements of this test within a standard NHS-funded sight test where clinically indicated."}}]}0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"MedicalWebPage\",\"name\":\"Contact Lens Fitting & Check-up\",\"description\":\"A specialist appointment to fit, assess, or review your contact lenses for comfort, safety, and clear vision.\",\"url\":\"https://www.eyetest.co.uk/eye-tests/contact-lens-fitting\",\"mainContentOfPage\":{\"@type\":\"WebPageElement\",\"cssSelector\"