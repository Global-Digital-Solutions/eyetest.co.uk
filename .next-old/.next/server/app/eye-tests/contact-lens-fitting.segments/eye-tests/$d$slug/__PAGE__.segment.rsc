5:["$","section",null,{"className":"py-16 sm:py-20","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-3 gap-12","children":[["$","article",null,{"className":"lg:col-span-2","children":[["$","div",null,{"className":"mb-12","children":[["$","h2",null,{"className":"text-2xl font-bold text-[var(--color-navy)] mb-6","style":{"fontFamily":"var(--font-display)"},"children":["What is a ","contact lens fitting & check-up","?"]}],["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"text-gray-600 leading-relaxed mb-4","children":"A contact lens fitting is a separate appointment from your standard sight test and is required for anyone who wants to start wearing contact lenses, change their lens type, or have their existing lenses reviewed. During the fitting, your optometrist or contact lens optician will take detailed measurements of your eyes, assess your tear film quality, and recommend the most suitable lens type and material for your lifestyle and prescription."}],["$","p","1",{"className":"text-gray-600 leading-relaxed mb-4","children":"If you are a new wearer, the appointment will include a teach session where you learn how to insert, remove, and care for your lenses safely. Your practitioner will check the fit of the lenses on your eyes and ensure they provide clear, comfortable vision. A follow-up appointment is usually booked to confirm everything is working well before your prescription is finalised."}],["$","p","2",{"className":"text-gray-600 leading-relaxed mb-4","children":"Contact lens check-ups are legally required at least once a year in the UK. Your contact lens prescription (known as a specification) is only valid while your check-ups are up to date. These appointments verify that your lenses remain the right fit, your eyes are healthy, and your prescription has not changed. Skipping check-ups can lead to undetected problems such as corneal infections, dry eye, or oxygen deprivation to the cornea — all of which can affect your long-term eye health."}]]}]]}],["$","div",null,{"className":"mb-12","children":[["$","h2",null,{"className":"text-2xl font-bold text-[var(--color-navy)] mb-6","style":{"fontFamily":"var(--font-display)"},"children":["Who needs a ","contact lens fitting & check-up","?"]}],["$","ul",null,{"className":"space-y-3","children":[["$","li","Anyone wanting to wear contact lenses for the first time",{"className":"flex items-start gap-3","children":[["$","svg",null,{"className":"w-5 h-5 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"className":"text-gray-600","children":"Anyone wanting to wear contact lenses for the first time"}]]}],["$","li","Current contact lens wearers due for their annual or six-monthly check-up",{"className":"flex items-start gap-3","children":[["$","svg",null,{"className":"w-5 h-5 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"className":"text-gray-600","children":"Current contact lens wearers due for their annual or six-monthly check-up"}]]}],["$","li","People wanting to switch from glasses to contacts or try a different lens type",{"className":"flex items-start gap-3","children":[["$","svg",null,{"className":"w-5 h-5 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":"$Ld"}],"$Le"]}],"$Lf","$L10","$L11"]}]]}],"$L12","$L13","$L14"]}],"$L15"]}]}]}]
