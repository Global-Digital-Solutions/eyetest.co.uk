11:T439,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a home visit eye test?","acceptedAnswer":{"@type":"Answer","text":"A full NHS-funded sight test carried out in your own home if you cannot visit an optician's practice."}},{"@type":"Question","name":"How long does a home visit eye test take?","acceptedAnswer":{"@type":"Answer","text":"A home visit eye test typically takes 30–45 minutes."}},{"@type":"Question","name":"How much does a home visit eye test cost?","acceptedAnswer":{"@type":"Answer","text":"Free on the NHS for eligible patients. Private home visits typically £40–£80"}},{"@type":"Question","name":"How often should I have a home visit eye test?","acceptedAnswer":{"@type":"Answer","text":"Every 2 years, or annually if clinically recommended"}},{"@type":"Question","name":"Is a home visit eye test available on the NHS?","acceptedAnswer":{"@type":"Answer","text":"Yes, a home visit eye test is available on the NHS for eligible patients. Check with your local optician for specific eligibility criteria."}}]}5:[["$","$L10",null,{}],["$","main",null,{"className":"flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"MedicalWebPage\",\"name\":\"Home Visit Eye Test\",\"description\":\"A full NHS-funded sight test carried out in your own home if you cannot visit an optician's practice.\",\"url\":\"https://www.eyetest.co.uk/eye-tests/home-visit-eye-test\",\"mainContentOfPage\":{\"@type\":\"WebPageElement\",\"cssSelector\":\"article\"},\"author\":{\"@type\":\"Organization\",\"name\":\"eyetest.co.uk\",\"url\":\"https://www.eyetest.co.uk\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"eyetest.co.uk\",\"url\":\"https://www.eyetest.co.uk\"},\"dateModified\":\"2026-06-16\",\"lastReviewed\":\"2026-06-16\",\"breadcrumb\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"na