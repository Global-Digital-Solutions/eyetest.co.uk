19:["$","section",null,{"className":"py-16 sm:py-20","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-3 gap-12","children":[["$","article",null,{"className":"lg:col-span-2","children":[["$","div",null,{"className":"mb-12","children":[["$","h2",null,{"className":"text-2xl font-bold text-[var(--color-navy)] mb-6","style":{"fontFamily":"var(--font-display)"},"children":["What is a ","home visit eye test","?"]}],["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"text-gray-600 leading-relaxed mb-4","children":"A home visit eye test — also known as a domiciliary eye test — is a full sight test carried out in your own home by a qualified optometrist or ophthalmic medical practitioner. This service is available on the NHS for people who cannot get to an optician's practice unaccompanied due to a physical or mental illness or disability. The clinical standard of the test is the same as you would receive in a high-street practice — portable equipment allows the optometrist to carry out all the necessary checks."}],["$","p","1",{"className":"text-gray-600 leading-relaxed mb-4","children":"You are eligible for a free NHS home visit if leaving your home to attend an optician is not possible without help. This includes many elderly or housebound patients, people in care homes or nursing homes, those with severe mobility issues, and individuals with conditions such as advanced dementia or agoraphobia. The optometrist will bring all the equipment needed, including portable letter charts, a trial lens set, a slit lamp, and often a portable fundus camera."}],["$","p","2",{"className":"text-gray-600 leading-relaxed mb-4","children":"To arrange a home visit, you can contact a domiciliary optical practice directly, ask your GP surgery for a recommendation, or call NHS 111 for guidance. Many local opticians also offer this service — it is worth asking when you call to book. The optometrist can dispense glasses during the visit or arrange for them to be delivered, making the entire process as convenient as possible for those who cannot easily leave their home."}]]}]]}],["$","div",null,{"className":"mb-12","children":[["$","h2",null,{"className":"text-2xl font-bold text-[var(--color-navy)] mb-6","style":{"fontFamily":"var(--font-display)"},"children":["Who needs a ","home visit eye test","?"]}],["$","ul",null,{"className":"space-y-3","children":[["$","li","People who cannot leave their home unaccompanied due to physical or mental health conditions",{"className":"flex items-start gap-3","children":[["$","svg",null,{"className":"w-5 h-5 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"className":"text-gray-600","children":"People who cannot leave their home unaccompanied due to physical or mental health conditions"}]]}],["$","li","Elderly or housebound individuals",{"className":"flex items-start gap-3","children":[["$","svg",null,{"className":"w-5 h-5 text-[var(--color-primary)] shrink-0 mt-0.5","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"className":"text-gray-600","children":"Elderly or housebound individuals"}]]}],["$","li","Residents of care homes or nursing homes",{"className":"flex items-start gap-3","children":["$L1e","$L1f"]}],"$L20","$L21","$L22"]}]]}],"$L23","$L24","$L25"]}],"$L26"]}]}]}]
