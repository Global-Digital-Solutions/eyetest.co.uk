c:["$","section",null,{"className":"py-16 sm:py-20","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-3 gap-12","children":[["$","article",null,{"className":"lg:col-span-2","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"Boots Opticians is one of the UK's most trusted optician chains, with over 500 stores across the country. They offer both standard and enhanced eye test options, with a focus on using advanced diagnostic technology."}],["$","p","1",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"A standard eye test at Boots Opticians costs approximately £29.95 in 2026. This includes a full assessment of your vision, a prescription check, eye pressure measurement, and examination of your eye health. The appointment takes around 25 to 30 minutes."}],["$","p","2",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"Boots' Enhanced Eye Health Check costs approximately £39.95 and includes everything in the standard test plus an OCT (Optical Coherence Tomography) scan. This advanced scan provides a detailed 3D view of the layers of your retina and optic nerve, enabling your optometrist to detect conditions years before they would be visible with standard examination techniques. Many Boots stores also include ultra-wide-field retinal photography in the enhanced check. This premium package represents good value compared to having an OCT scan added separately."}],["$","p","3",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"Boots Opticians provides NHS-funded eye tests for all eligible patients at no charge. They accept Boots Advantage Card points on eye tests and glasses purchases, and occasionally run promotional offers. Boots stores in larger shopping centres and retail parks often offer extended opening hours including Sundays."}],["$","p","4",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"In addition to standard eye tests, Boots offers specialist services including contact lens fitting, children's eye tests, and eye health screenings. Many stores have been refurbished with the latest examination equipment and offer a comfortable, modern environment. Booking is available online through the Boots Opticians website, by phone, or in store."}]]}]}],["$","aside",null,{"className":"lg:col-span-1","children":["$","div",null,{"className":"sticky top-8 space-y-6","children":[["$","div",null,{"className":"bg-white border border-gray-100 rounded-2xl shadow-sm p-6","children":[["$","h3",null,{"className":"text-lg font-bold text-[var(--color-navy)] mb-4","style":{"fontFamily":"var(--font-display)"},"children":"Key facts"}],["$","dl",null,{"className":"space-y-4","children":[["$","div","Specsavers stores",{"className":"flex items-start gap-3","children":[["$","div",null,{"className":"w-10 h-10 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center shrink-0","children":["$","svg",null,{"className":"w-5 h-5 text-[var(--color-primary)]","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}]}],["$","div",null,{"children":[["$","dt",null,{"className":"text-xs text-gray-400 uppercase tracking-wider font-medium","children":"Specsavers stores"}],["$","dd",null,{"className":"text-sm font-medium text-[var(--color-navy)]","children":"900+ UK"}]]}]]}],["$","div","Boots stores",{"className":"flex items-start gap-3","children":["$L13","$L14"]}],"$L15","$L16"]}]]}],"$L17","$L18"]}]}]]}]}]}]
