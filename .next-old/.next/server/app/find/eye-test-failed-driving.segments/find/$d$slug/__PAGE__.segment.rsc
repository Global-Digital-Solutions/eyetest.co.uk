3:T5cd,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I retake my driving test after failing the eye test?","acceptedAnswer":{"@type":"Answer","text":"Yes. Book an eye test with an optician, get glasses or contact lenses if needed, and then rebook your driving test. There is no special waiting period. You must wear your correction every time you drive."}},{"@type":"Question","name":"Do I need to tell the DVLA I failed the eye test?","acceptedAnswer":{"@type":"Answer","text":"If you simply need glasses and your corrected vision meets the standard, you do not need to inform the DVLA. If your vision cannot be corrected to the driving standard, you must inform them. Your optometrist will advise you."}},{"@type":"Question","name":"Can I practise driving if I failed the eye test?","acceptedAnswer":{"@type":"Answer","text":"You should not drive or practise driving until you have had your vision corrected. Once you have the right glasses or contact lenses and your optometrist confirms your corrected vision meets the standard, you can resume practice."}},{"@type":"Question","name":"What is the legal eyesight standard for driving?","acceptedAnswer":{"@type":"Answer","text":"You must be able to read a number plate from 20 metres, which equates to approximately 6/12 visual acuity. You must also have an adequate field of vision of at least 120 degrees horizontally. Glasses or contact lenses can be worn to meet these standards."}}]}0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Failed the Eye Test Part of Your Driving Test? What to Do Next\",\"description\":\"What happens if you fail the number plate reading test during your driving test, and the steps to take to get back on the road safely.\",\"url\":\"https://www.eyetest.co.uk/find/eye-test-failed-driving\",\"author\":{\"@type\":\"Organization\",\"name\":\"eyetest.co.uk\",\"url\":\"https://www.eyetest.co.uk\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"eyetest.co.uk\",\"url\":\"https://www.eyetest.co.uk\"},\"dateModified\":\"2026-06-16\",\"breadcrumb\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.eyetest.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Find\",\"item\":\"https://www.eyetest.co.uk/find\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Failed the Eye Test Part of Your Driving Test? What to Do Next\",\"item\":\"https://www.eyetest.co.uk/find/eye-test-failed-driving\"}]}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$3"}}],["$","section",null,{"className":"relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 bg-cover bg-center bg-no-repeat","style":{"backgroundImage":"url('https://images.unsplash.com/photo-1766310549795-dd0fc75d499f?auto=format&fit=crop&w=1920&q=80')"}}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-br from-[var(--color-navy)]/92 via-[#112247]/88 to-[var(--color-navy-light)]/92"}],["$","div",null,{"className":"absolute -top-32 -right-32 w-96 h-96 bg-[var(--color-primary)] rounded-full opacity-[0.07] blur-3xl"}],["$","div",null,{"className":"absolute -bottom-24 -left-24 w-72 h-72 bg-[var(--color-primary)] rounded-full opacity-[0.04] blur-3xl"}],"$L4"]}],"$L5","$L6","$L7","$L8"]}],"$L9"],["$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"ssq08EaNRRySny1_GDRUp"}
