a:["$","section",null,{"className":"py-16 sm:py-20","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-3 gap-12","children":[["$","article",null,{"className":"lg:col-span-2","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"Vision Express is one of the UK's leading optician chains with approximately 400 stores. They are known for their clinical focus, advanced equipment, and a wide range of designer eyewear. Their eye tests are competitively priced and include comprehensive clinical checks."}],["$","p","1",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"A standard eye test at Vision Express costs approximately £30 in 2026. The test includes a thorough assessment of your visual acuity, a refraction to measure your glasses or contact lens prescription, tonometry (eye pressure measurement) to screen for glaucoma, and a detailed examination of the front and back of your eyes using specialist instruments."}],["$","p","2",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"Vision Express offers an enhanced test option that includes OCT scanning for an additional charge, typically around £20 to £30 on top of the standard test. Some stores also offer retinal photography as part of their standard or enhanced packages. Vision Express has invested significantly in advanced diagnostic technology, and many stores have recently been refurbished with the latest examination equipment."}],["$","p","3",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"For patients who qualify, Vision Express provides free NHS-funded eye tests. They are a major provider of NHS eye care services across the UK. The chain also offers specialist services including contact lens fitting, children's eye tests, and emergency eye care at many locations."}],["$","p","4",{"className":"text-gray-600 leading-relaxed mb-5 text-base","children":"Booking at Vision Express is available online, by phone, or in store. Their online booking system shows real-time availability and allows you to select your preferred store, date, and time. Vision Express stores are typically open Monday to Saturday, with many also opening on Sundays. They accept most health insurance schemes and workplace eye care vouchers."}]]}]}],["$","aside",null,{"className":"lg:col-span-1","children":["$","div",null,{"className":"sticky top-8 space-y-6","children":[["$","div",null,{"className":"bg-white border border-gray-100 rounded-2xl shadow-sm p-6","children":[["$","h3",null,{"className":"text-lg font-bold text-[var(--color-navy)] mb-4","style":{"fontFamily":"var(--font-display)"},"children":"Key facts"}],["$","dl",null,{"className":"space-y-4","children":[["$","div","Specsavers stores",{"className":"flex items-start gap-3","children":[["$","div",null,{"className":"w-10 h-10 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center shrink-0","children":["$","svg",null,{"className":"w-5 h-5 text-[var(--color-primary)]","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}]}],["$","div",null,{"children":[["$","dt",null,{"className":"text-xs text-gray-400 uppercase tracking-wider font-medium","children":"Specsavers stores"}],["$","dd",null,{"className":"text-sm font-medium text-[var(--color-navy)]","children":"900+ UK"}]]}]]}],["$","div","Boots stores",{"className":"flex items-start gap-3","children":["$L11","$L12"]}],"$L13","$L14"]}]]}],"$L15","$L16"]}]}]]}]}]}]
