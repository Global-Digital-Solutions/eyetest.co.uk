31:["$","div",null,{"className":"mt-8 prose prose-lg max-w-none text-gray-600 space-y-4","children":[["$","h3",null,{"className":"text-xl font-semibold text-[var(--color-navy)] mt-8 mb-4","style":{"fontFamily":"var(--font-display)"},"children":["How to book an NHS eye test in ","Tunbridge Wells"]}],["$","p",null,{"children":["Booking an NHS eye test in ","Tunbridge Wells"," is straightforward. Simply search on eyetest.co.uk using the postcode ","TN1 1YB"," and filter for opticians that accept NHS patients. When you book your appointment, let the practice know you would like an NHS-funded test, and bring your proof of eligibility (such as your benefits letter, HC2 certificate, or proof of age) with you on the day."]}],["$","h3",null,{"className":"text-xl font-semibold text-[var(--color-navy)] mt-8 mb-4","style":{"fontFamily":"var(--font-display)"},"children":"NHS optical vouchers"}],["$","p",null,{"children":["If you are eligible for a free NHS eye test and you need glasses or contact lenses, you may also receive an NHS optical voucher. This voucher provides a fixed amount towards the cost of your eyewear, with the value depending on your prescription strength. For many people, particularly children and those with straightforward prescriptions, the voucher can cover the full cost of a basic pair of glasses. Your optician in ","Tunbridge Wells"," will apply the voucher automatically and let you know if there is any remaining balance to pay."]}],["$","h3",null,{"className":"text-xl font-semibold text-[var(--color-navy)] mt-8 mb-4","style":{"fontFamily":"var(--font-display)"},"children":["Which opticians in ","Tunbridge Wells"," accept NHS patients?"]}],["$","p",null,{"children":["The majority of opticians in ","Tunbridge Wells"," are registered to provide NHS-funded eye tests. This includes major chains such as Boots Opticians and ASDA Opticians, as well as most independent practices. When comparing opticians on eyetest.co.uk, look for the NHS badge to confirm that a practice accepts NHS patients. If you are unsure about your eligibility, any optician can check for you when you call to book."]}]]}]
