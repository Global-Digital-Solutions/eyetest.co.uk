a:["$","section",null,{"className":"py-16 sm:py-20 bg-gradient-to-b from-[var(--color-primary)]/5 to-white","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-bold text-[var(--color-navy)] mb-6","style":{"fontFamily":"var(--font-display)"},"children":["What to expect from an eye test in ","Tunbridge Wells"]}],["$","div",null,{"className":"prose prose-lg max-w-none text-gray-600 space-y-4","children":["$","p",null,{"children":["If it has been a while since your last eye test, or if this is your first visit to an optician in ","Tunbridge Wells",", it helps to know what to expect. A standard eye test typically lasts between 20 and 30 minutes, though enhanced examinations with additional tests such as OCT scanning may take up to 45 minutes. Here is a step-by-step guide to what happens during a typical appointment:"]}]}],["$","div",null,{"className":"mt-8 space-y-6 relative","children":[["$","div",null,{"className":"absolute left-[27px] top-[40px] bottom-[40px] w-0.5 bg-[var(--color-primary)]/20 hidden sm:block"}],[["$","div","1",{"className":"relative flex gap-4 bg-white rounded-2xl p-6 border border-gray-100 shadow-sm","children":[["$","div",null,{"className":"w-12 h-12 rounded-full bg-[var(--color-primary)] flex items-center justify-center text-white font-bold text-base shrink-0 relative z-10","children":"1"}],["$","div",null,{"children":[["$","h3",null,{"className":"font-semibold text-[var(--color-navy)] mb-1","children":"Health and lifestyle discussion"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Your optometrist will begin by asking about your general health, any medications you take, your family history of eye conditions, and any specific concerns you have about your vision. This helps them tailor the examination to your individual needs."}]]}]]}],["$","div","2",{"className":"relative flex gap-4 bg-white rounded-2xl p-6 border border-gray-100 shadow-sm","children"