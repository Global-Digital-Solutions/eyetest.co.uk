3a:["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, ASDA Opticians accepts NHS optical vouchers. If you are eligible for an NHS voucher — which includes children under 16, people on qualifying benefits, and those with complex prescriptions — it can be applied towards the cost of your glasses. Because ASDA's frame prices are very competitive, many patients find that the NHS voucher covers the full cost of a basic pair of glasses."}]}]
3b:["$","details","3",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Does ASDA Opticians offer contact lenses?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, ASDA Opticians provides contact lens assessments, fittings, and ongoing supply. They stock lenses from major manufacturers at competitive prices. Monthly supply plans are available for regular contact lens wearers, though the range may be narrower than at specialist contact lens providers."}]}]]}]
3c:["$","details","4",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Is there free parking at ASDA Opticians?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, one of the significant advantages of ASDA Opticians is free parking. All ASDA stores provide free car parking for customers, which means you can drive to your eye test without worrying about parking charges or time limits. This is a notable benefit compared to high-street opticians in town centres where parking can be expensive and difficult to find."}]}]]}]
3d:["$","details","5",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Does ASDA Opticians do home visits?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"No, ASDA Opticians does not currently offer a home visit eye testing service. All eye tests are carried out at ASDA supermarket locations. If you or a family member cannot travel to a store for an eye test, you may want to consider opticians that do offer home visits, such as Specsavers or Scrivens."}]}]]}]
3e:["$","details","6",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"How often should I visit ASDA Opticians for an eye test?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"The general recommendation is an eye test every two years for most adults, or annually if you are over 70, diabetic, have a family history of glaucoma, or have been advised by your optometrist to come back sooner. Children should have their eyes tested annually. Regular tests are important not just for keeping your prescription up to date but for detecting eye health issues early."}]}]]}]
3f:["$","details","7",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"What are the opening hours for ASDA Opticians?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"ASDA Opticians generally follow the opening hours of the ASDA supermarket they are located in, which typically means long opening hours including evenings and weekends. Most stores are open Monday to Saturday from around 9am to 8pm or 9pm, and Sunday from around 10am to 4pm. Hours may vary by location, so check your local store's specific times when booking."}]}]]}]
