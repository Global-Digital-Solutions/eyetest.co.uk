34:["$","details","4",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"How long does an eye test take at Boots?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"A standard NHS or private eye test at Boots Opticians typically takes around 20 to 25 minutes. If you opt for the enhanced eye test with OCT scan, you should allow approximately 30 to 35 minutes. Contact lens consultations tend to take a little longer — around 30 to 40 minutes — as they include additional measurements and a trial fitting."}]}]]}]
35:["$","details","5",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Can I get my glasses the same day at Boots Opticians?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Boots Opticians does not typically offer same-day glasses. Most orders are sent to a central glazing laboratory, and you can expect your glasses to be ready for collection within 7 to 10 working days. Some stores may offer an express service for simple prescriptions, but availability varies by location. You will be notified by text or email when your glasses are ready to collect."}]}]]}]
36:["$","details","6",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"What frame brands does Boots Opticians stock?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Boots Opticians carries an extensive range of designer and own-brand frames. Thanks to being part of the EssilorLuxottica group, they have access to brands including Ray-Ban, Oakley, Prada, Versace, Dolce & Gabbana, Burberry, Ralph Lauren, and many more. They also offer their own Boots-branded frames at more affordable price points, and children's ranges featuring popular character brands."}]}]]}]
37:["$","details","7",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Does Boots Opticians accept NHS vouchers for glasses?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, Boots Opticians fully participates in the NHS optical voucher scheme. If you are eligible for an NHS voucher, it can be put towards the cost of your glasses or contact lenses. The voucher value depends on your prescription strength, and any difference between the voucher value and the cost of your chosen frames and lenses is paid by you. Children and some adults on qualifying benefits can receive glasses entirely covered by the NHS voucher."}]}]]}]
