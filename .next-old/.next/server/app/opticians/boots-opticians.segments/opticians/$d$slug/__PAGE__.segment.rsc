84:["$","div","4",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Children's Eye Test"}],["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full bg-[var(--color-nhs-blue)]/10 px-2.5 py-0.5 text-xs font-medium text-[var(--color-nhs-blue)]","children":"NHS"}]]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"A specially adapted eye test for children, using age-appropriate charts and techniques. All children under 16 are entitled to a free NHS-funded eye test. The optometrist will check for common childhood vision problems including lazy eye (amblyopia), squint (strabismus), and long or short-sightedness. Boots stocks a wide range of children's frames, many available free under the NHS voucher scheme."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"Free (NHS funded)"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"20-30 minutes"}]]}]]}]
