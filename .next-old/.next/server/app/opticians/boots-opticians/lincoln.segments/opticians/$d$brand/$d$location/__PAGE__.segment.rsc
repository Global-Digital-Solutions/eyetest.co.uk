55:["$","span",null,{"children":"How long does an eye test take at Boots?"}]
56:["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]
57:["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"A standard eye test at Boots typically takes between 20 and 30 minutes. If you opt for an enhanced test with OCT scanning, allow around 35 to 45 minutes. Contact lens consultations may take 30 to 45 minutes as they involve additional measurements and a trial fitting."}]
58:["$","details","Do I need to bring anything to my eye test at Boots?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"Do I need to bring anything to my eye test at Boots?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"Yes, bring your current glasses or contact lenses, any NHS exemption evidence if you qualify for a free test, and a list of any medications you take. If you have a previous prescription from another optician, bringing that along can be helpful for comparison."}]]}]
59:["$","details","What happens if I need glasses after my Boots eye test?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"What happens if I need glasses after my Boots eye test?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"After your eye test at Boots in Lincoln, your optometrist will provide a written prescription. You can choose glasses from Boots's range, or take your prescription to any other optician. If you qualify for an NHS optical voucher, this can be put towards the cost of your glasses."}]]}]
5a:["$","details","Can children have eye tests at Boots in Lincoln?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"Can children have eye tests at Boots in Lincoln?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"Yes, Boots in Lincoln offers eye tests for children of all ages. All children under 16 are entitled to free NHS-funded eye tests. Boots optometrists use age-appropriate techniques including picture charts and matching games for younger children who cannot yet read letters."}]]}]
5b:["$","details","How often should I have an eye test?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"How often should I have an eye test?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"The recommended frequency is every two years for most adults. However, you should have annual eye tests if you are over 70, have diabetes, have a family history of glaucoma, or have been advised by your optometrist. Children should have their eyes tested annually. Book your next eye test at Boots in Lincoln through eyetest.co.uk."}]]}]
5c:["$","details","What services does Boots offer in Lincoln?",{"className":"group bg-white border border-gray-100 rounded-2xl shadow-sm","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-[var(--color-navy)] hover:text-[var(--color-primary)] transition-colors","children":[["$","span",null,{"children":"What services does Boots offer in Lincoln?"}],["$","svg",null,{"className":"w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed","children":"Boots in Lincoln offers: NHS Eye Tests, Private Eye Tests, Contact Lenses, Glasses, Hearing Tests, Children's Eye Tests, OCT Scan, Diabetic Screening. Book your appointment through eyetest.co.uk to check real-time availability."}]]}]
