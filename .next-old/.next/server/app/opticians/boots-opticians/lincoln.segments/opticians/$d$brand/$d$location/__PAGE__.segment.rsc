6:[["$","section",null,{"className":"max-w-7xl mx-auto px-4 py-16 sm:py-20","children":["$","div",null,{"className":"grid gap-8 lg:grid-cols-3","children":[["$","div",null,{"className":"lg:col-span-2","children":[["$","h2",null,{"className":"font-[family-name:var(--font-display)] text-2xl font-bold text-[var(--color-navy)] mb-4","children":["About ","Boots Opticians"," in ","Lincoln"]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-base mb-4","children":"Boots Opticians is one of the UK's largest and most recognised optical chains, operating from Boots pharmacy stores across the country. They offer a full range of eye care services including NHS and private eye tests, designer and own-brand glasses, contact lenses, and hearing care. With their convenient high-street locations and integration with Boots Advantage Card loyalty points, they remain a popular choice for routine eye care."}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-base mb-4","children":["Boots Opticians"," in ","Lincoln, Lincolnshire"," is one of ","600"," ","Boots"," branches across the United Kingdom. Whether you need a routine NHS sight test, a private eye examination, or a more advanced health screening such as an OCT scan, ","Boots"," in ","Lincoln"," can help you keep your vision clear and your eyes healthy. The ","Lincoln"," area, covered by the postcode ","LN1 3BH",", is well served by ","Boots"," and other leading opticians, giving local patients a wide choice of eye care providers."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-base mb-4","children":["Finding the right optician in ","Lincoln"," can be straightforward when you compare services, prices, and availability on eyetest.co.uk. ","Boots"," is known for offering ","nhs eye tests, private eye tests, contact lenses, glasses",", and more. Patients visiting ","Boots"," in ","Lincoln"," benefit from ","both NHS-funded and private eye tests",", professional optometrists registered with the General Optical Council, and a convenient location within the ","Lincoln"," area."]}],["$","p",null,{"className":"text-gray-600 leading-relaxed text-base mb-6","children":["Boots"," was founded in ","1983"," and has grown to become one of the most recognised names in UK eye care. Patients in ","Lincoln"," choose ","Boots"," for a variety of reasons, including ","earn and spend boots advantage card points on eye care"," and ","wide selection of designer frames from brands like ray-ban, oakley, and prada",". If you are looking for an eye test near ","LN1 3BH",", ","Boots"," in ","Lincoln"," is an excellent choice for comprehensive eye care in ","Lincoln","."]}],["$","h3",null,{"className":"font-[family-name:var(--font-display)] text-lg font-semibold text-[var(--color-navy)] mb-4","children":["Services available at ","Boots"," in ","Lincoln"]}],["$","div",null,{"className":"grid gap-3 sm:grid-cols-2","children":[["$","div","NHS Eye Tests",{"className":"flex items-center gap-3 bg-gray-50 rounded-xl p-3 border border-gray-100","children":[["$","svg",null,{"className":"w-4 h-4 text-[var(--color-success)] shrink-0","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}],["$","span",null,{"className":"text-sm font-medium text-[var(--color-navy)]","children":"NHS Eye Tests"}]]}],["$","div","Private Eye Tests",{"className":"flex items-center gap-3 bg-gray-50 rounded-xl p-3 border border-gray-100","children":[["$","svg",null,{"className":"w-4 h-4 text-[var(--color-success)] shrink-0","fill":"currentColor","viewBox":"0 0 20 20","children":"$Ld"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14"]}]]}],"$L15"]}]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]
