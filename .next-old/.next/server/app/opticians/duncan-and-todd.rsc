38:["$","details","5",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Can I book a Duncan & Todd appointment through eyetest.co.uk?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, Duncan & Todd practices are available for booking through eyetest.co.uk. Enter your postcode to find your nearest practice, choose your appointment type, and select a date and time that suits you. You will receive a confirmation email with everything you need to know before your visit."}]}]]}]
39:["$","details","6",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"How does the NHS optical voucher scheme work in Scotland?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"In Scotland, all residents receive free NHS eye tests, and NHS optical vouchers are available to help with the cost of glasses. The voucher values are set by NHS Scotland and depend on your prescription and personal circumstances. Children, people on qualifying benefits, and those with complex prescriptions receive higher-value vouchers. Your Duncan & Todd dispensing optician will explain exactly how much the voucher covers and what, if anything, you will need to pay on top."}]}]]}]
