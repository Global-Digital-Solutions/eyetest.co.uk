4b:["$","div","4",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Myopia Management for Children"}],false]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"A specialist service designed to slow the progression of myopia (short-sightedness) in children. Leightons uses evidence-based interventions including MiSight contact lenses, Miyosmart spectacle lenses, and orthokeratology (overnight corneal reshaping lenses). The service includes an initial assessment, ongoing monitoring, and regular reviews to track progression."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"From £60 (initial assessment)"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"45 minutes (initial), 30 minutes (follow-up)"}]]}]]}]
