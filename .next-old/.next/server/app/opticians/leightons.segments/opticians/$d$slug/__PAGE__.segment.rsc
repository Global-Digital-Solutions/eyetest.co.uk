fraction, and eye health checks. Even within the NHS test, Leightons optometrists take time to discuss findings and answer questions fully."}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Free (if eligible)"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"20-25 minutes"}]}],["$","td",null,{"className":"px-6 py-4 text-center","children":["$","span",null,{"className":"inline-flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-success)]/10","children":["$","svg",null,{"className":"w-4 h-4 text-[var(--color-success)]","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}]}]}]]}],["$","tr","1",{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-medium text-[var(--color-navy)]","children":"Private Eye Test"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"A comprehensive private eye examination that allows more time for discussion and assessment than the standard NHS test. Leightons' private test includes detailed refraction, binocular vision assessment, and a thorough examination of eye health using slit lamp biomicroscopy."}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"From £39"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"30 minutes"}]}],["$","td",null,{"className":"px-6 py-4 text-center","children":["$","span",null,{"className":"inline-flex items-cent