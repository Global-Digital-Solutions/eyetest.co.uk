25:["$","details","3",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Do Rawlings appointments take longer than other opticians?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, Rawlings is known for allocating longer appointment times than most chain opticians. A standard eye test at Rawlings typically takes 25 to 35 minutes, compared to 20 to 25 minutes at most chains. This extra time allows the optometrist to carry out a more thorough examination and to discuss findings and recommendations in greater detail. Many patients who have moved to Rawlings from chain opticians specifically cite the longer appointments as a reason for switching."}]}]]}]
