{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/opticians/layout,_N_T_/opticians/[slug]/layout,_N_T_/opticians/[slug]/page,_N_T_/opticians/scrivens"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/opticians/$d$slug/__PAGE__",
    "/opticians/$d$slug",
    "/opticians",
    "/_index",
    "/_head"
  ]
}