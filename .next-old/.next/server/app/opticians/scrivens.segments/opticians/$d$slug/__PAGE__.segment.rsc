2d:["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, hearing care is a core part of the Scrivens service. Every Scrivens branch offers hearing assessments, which are provided free of charge by qualified audiologists. If hearing loss is detected, Scrivens can supply both NHS-funded hearing aids (where eligible) and private digital hearing aids from leading manufacturers. The combination of optical and hearing care under one roof is a significant convenience for patients."}]}]
2e:["$","details","3",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Where are Scrivens branches located?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Scrivens operates approximately 100 branches across the Midlands, the South West, and the South of England. Concentrations include the West Midlands (Birmingham, Coventry, Wolverhampton), the East Midlands (Nottingham, Leicester, Derby), the South West (Bristol, Bath, Exeter, Plymouth), and parts of southern England (Southampton, Portsmouth, Reading, Oxford). They do not currently have branches in the North of England, Scotland, Wales, or Northern Ireland."}]}]]}]
2f:["$","details","4",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"How much do glasses cost at Scrivens?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Scrivens offers a range of frames at competitive prices. Complete glasses — frames with single-vision lenses — start from around £49. The selection includes a mix of own-brand frames and recognised mid-range brands. Lens upgrades such as anti-reflection coatings, varifocals, and thinner lenses are available at additional cost. NHS optical vouchers are accepted and can be put towards the cost of glasses for eligible patients."}]}]]}]
30:["$","details","5",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Can I get an NHS eye test at Scrivens?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, Scrivens provides free NHS-funded eye tests for all eligible patients. Eligibility is the same as at any UK optician — children under 16, adults over 60, those on qualifying benefits, and patients with certain medical conditions. Scrivens also provides NHS-funded home visits for eligible patients who cannot attend a branch in person."}]}]]}]
31:["$","details","6",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Does Scrivens offer hearing aids on the NHS?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, Scrivens is contracted to provide NHS hearing aids at many of its branches. If you are referred by your GP or if a Scrivens audiologist identifies hearing loss, you may be eligible for a free NHS digital hearing aid. Private hearing aids are also available for patients who want a wider choice of styles and technology levels, with prices starting from around £395 per aid."}]}]]}]
