8f:["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"An initial appointment to assess your suitability for contact lenses. Includes corneal topography measurements, tear film evaluation, and a trial lens fitting. Your optometrist will discuss the available lens options — including daily disposables, extended wear, toric lenses for astigmatism, and multifocal lenses for presbyopia — and recommend the most suitable type for your eyes and lifestyle."}]
90:["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"From £30"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"30-40 minutes"}]]}]
91:["$","div","4",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Home Visit Eye Test"}],["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full bg-[var(--color-nhs-blue)]/10 px-2.5 py-0.5 text-xs font-medium text-[var(--color-nhs-blue)]","children":"NHS"}]]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"A full NHS or private eye test carried out in the patient's own home by a Specsavers domiciliary optometrist. This service is available for people who cannot visit a store unaccompanied due to a physical or mental disability or illness. The optometrist brings portable equipment and a selection of frames, so glasses can be ordered during the same visit. NHS-funded home visits are free for eligible patients."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"Free (NHS eligible) / From £30 (private)"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"30-40 minutes"}]]}]]}]
92:["$","div","5",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Hearing Test"}],false]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"A comprehensive hearing assessment provided at Specsavers audiology clinics within their opticians stores. The test includes a discussion of your hearing history, an otoscopic examination of your ear canal, and a pure tone audiometry test carried out in a soundproof booth. If hearing loss is detected, the audiologist will explain your options, including NHS-funded and private digital hearing aids."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"Free"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"30 minutes"}]]}]]}]
93:["$","div","6",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Children's Eye Test"}],["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full bg-[var(--color-nhs-blue)]/10 px-2.5 py-0.5 text-xs font-medium text-[var(--color-nhs-blue)]","children":"NHS"}]]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"A specially adapted eye test for children from age 3 upwards, carried out by experienced paediatric-friendly optometrists. The test uses picture charts, matching games, and retinoscopy to assess vision in younger children who may not yet recognise letters. All children under 16 (and under 19 in full-time education) qualify for a free NHS eye test, and Specsavers offers a wide range of children's frames covered by the NHS voucher."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"Free (NHS funded)"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"20-30 minutes"}]]}]]}]
