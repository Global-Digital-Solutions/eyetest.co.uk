3d:["$","tr","6",{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-medium text-[var(--color-navy)]","children":"Children's Eye Test"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"A specially adapted eye test for children from age 3 upwards, carried out by experienced paediatric-friendly optometrists. The test uses picture charts, matching games, and retinoscopy to assess vision in younger children who may not yet recognise letters. All children under 16 (and under 19 in full-time education) qualify for a free NHS eye test, and Specsavers offers a wide range of children's frames covered by the NHS voucher."}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Free (NHS funded)"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"20-30 minutes"}]}],["$","td",null,{"className":"px-6 py-4 text-center","children":["$","span",null,{"className":"inline-flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-success)]/10","children":["$","svg",null,{"className":"w-4 h-4 text-[var(--color-success)]","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}]}]}]]}]
3e:["$","div",null,{"className":"md:hidden space-y-4","children":[["$","div","0",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"NHS Eye Test"}],["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full bg-[var(--color-nhs-blue)]/10 px-2.5 py-0.5 text-xs font-medium text-[var(--color-nhs-blue)]","children":"NHS"}]]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"A thorough eye examination covered by the NHS for eligible patients. Specsavers optometrists assess visual acuity, refraction, eye coordination, and eye health using slit lamp examination and ophthalmoscopy. The test also includes a screening for glaucoma through intraocular pressure measurement. Eligible patients include children under 16, adults over 60, those receiving qualifying benefits, and people with certain medical conditions or a family history of glaucoma."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"Free (if eligible)"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"20-25 minutes"}]]}]]}],["$","div","1",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Private Eye Test"}],false]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"A full eye examination for patients who do not qualify for a free NHS eye test. The examination includes all the same clinical checks as the NHS test, including visual acuity, refraction, eye pressure measurement, and a detailed assessment of the internal and external health of the eyes. Specsavers recommends eye tests every two years for most adults, or more frequently if advised by your optometrist."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"From £25"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"20-25 minutes"}]]}]]}],["$","div","2",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"OCT Eye Health Check"}],false]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"An enhanced screening that uses Optical Coherence Tomography (OCT) to produce 3D cross-section images of the retina and optic nerve. This advanced scan can detect signs of serious eye conditions — including glaucoma, macular degeneration, and diabetic eye disease — at a much earlier stage than a standard eye test alone. Specsavers recommends this for patients over 25 as a baseline measurement."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"From £25 (in addition to eye test)"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"10 minutes (plus eye test)"}]]}]]}],["$","div","3",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Contact Lens Assessment"}],false]}],"$L8f","$L90"]}],"$L91","$L92","$L93"]}]
