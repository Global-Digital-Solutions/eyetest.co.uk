41:["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Yes, Specsavers operates a domiciliary (home visit) eye test service for patients who are unable to leave home unaccompanied due to a physical or mental health condition or disability. A Specsavers optometrist will visit you at home with portable testing equipment and a selection of frames. If you qualify for an NHS eye test, the home visit is also free. To arrange a home visit, contact your local Specsavers store directly."}]}]
42:["$","details","3",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"How often should I have an eye test at Specsavers?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"Specsavers recommends that most adults have an eye test every two years, or more frequently if advised by their optometrist. Children, people with diabetes, those over 70, and anyone with a family history of eye disease should typically have their eyes tested annually. Regular eye tests are important not just for updating your prescription but for detecting eye conditions early, when they are most treatable."}]}]]}]
43:["$","details","4",{"className":"group bg-white rounded-xl border border-gray-200 overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"text-sm font-semibold text-[var(--color-navy)] text-left","children":"Does Specsavers offer laser eye surgery?"}],["$","svg",null,{"className":"w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","strokeWidth":"2","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","d":"M19 9l-7 7-7-7"}]}]]}],["$","div",null,{"className":"px-6 pb-5","children":["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed","children":"No, Specsavers does not offer laser eye surgery or any surgical eye procedures. They are an optical retailer focused on eye testing, glasses, contact lenses, and hearing care. If you are interested in laser eye surgery, your Specsavers optometrist can advise you and refer you to an appropriate specialist or clinic."}]}]]}]
