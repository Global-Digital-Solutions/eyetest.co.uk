3b:["$","tr","4",{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-medium text-[var(--color-navy)]","children":"Home Visit Eye Test"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"A full NHS or private eye test carried out in the patient's own home by a Specsavers domiciliary optometrist. This service is available for people who cannot visit a store unaccompanied due to a physical or mental disability or illness. The optometrist brings portable equipment and a selection of frames, so glasses can be ordered during the same visit. NHS-funded home visits are free for eligible patients."}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Free (NHS eligible) / From £30 (private)"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"30-40 minutes"}]}],["$","td",null,{"className":"px-6 py-4 text-center","children":["$","span",null,{"className":"inline-flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-success)]/10","children":["$","svg",null,{"className":"w-4 h-4 text-[var(--color-success)]","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z","clipRule":"evenodd"}]}]}]}]]}]
