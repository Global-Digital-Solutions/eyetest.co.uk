4a:["$","div","Complex lens prescriptions",{"className":"bg-white rounded-xl border border-gray-200 p-4","children":[["$","h4",null,{"className":"font-semibold text-[var(--color-navy)] text-sm mb-1","children":"Complex lens prescriptions"}],["$","p",null,{"className":"text-xs text-gray-600 leading-relaxed","children":"Patients who hold a valid NHS complex lens voucher are entitled to free sight tests."}]]}]
4b:["$","div","Prisoners on release",{"className":"bg-white rounded-xl border border-gray-200 p-4","children":[["$","h4",null,{"className":"font-semibold text-[var(--color-navy)] text-sm mb-1","children":"Prisoners on release"}],["$","p",null,{"className":"text-xs text-gray-600 leading-relaxed","children":"People on leave from prison or on probation are eligible for free NHS eye tests."}]]}]
4c:["$","h3",null,{"className":"font-[family-name:var(--font-display)] text-xl font-semibold text-[var(--color-navy)] mb-3","children":"NHS optical vouchers"}]
4d:["$","p",null,{"className":"text-gray-600 leading-relaxed mb-4","children":["If you qualify for a free NHS eye test and need glasses, you may also be entitled to an NHS optical voucher. This voucher provides a contribution towards the cost of your spectacles or contact lenses. The value of the voucher depends on your prescription, ranging from around ","£","39 for a simple prescription to over ","£","215 for complex lenses. At ","Specsavers"," in ","Crawley",", the NHS voucher can be applied directly to reduce the cost of your chosen frames and lenses. For many children and adults on qualifying benefits, the voucher covers the full cost of a basic pair of glasses."]}]
4e:["$","h3",null,{"className":"font-[family-name:var(--font-display)] text-xl font-semibold text-[var(--color-navy)] mb-3","children":["How to claim your free NHS eye test at ","Specsavers"," in ","Crawley"]}]
4f:["$","p",null,{"className":"text-gray-600 leading-relaxed mb-4","children":["Claiming your free NHS eye test at ","Specsavers"," in ","Crawley"," is straightforward. Simply let the receptionist know that you believe you are eligible when you book your appointment, and bring your proof of eligibility to the appointment. Acceptable evidence includes your NHS exemption certificate, benefits letter, birth certificate (for age-related eligibility), medical card, or a valid HC2 certificate. If you are unsure whether you qualify, ","Specsavers"," staff in ","Crawley"," can check your eligibility when you arrive."]}]
50:["$","p",null,{"className":"text-gray-600 leading-relaxed","children":["Remember that NHS eligibility applies equally at all registered opticians in ","Crawley",", not just ","Specsavers",". If you are having difficulty getting an appointment at ","Specsavers",", you can use your NHS entitlement at any of the other opticians in the ","Crawley"," area. Use eyetest.co.uk to compare NHS availability at opticians near ","RH10 1BN","."]}]
