3:T4dd,{"@context":"https://schema.org","@type":"LocalBusiness","name":"Specsavers Optical Group Crawley","description":"Specsavers is the UK's largest optical retailer, founded in Guernsey by Doug and Dame Mary Perkins. Known for their value-for-money approach and iconic advertising campaigns, they operate a joint-venture partnership model where each store is co-owned by local optometrists. They provide comprehensive eye care, hearing services, and home visit testing across the UK and internationally.","url":"https://www.eyetest.co.uk/opticians/specsavers/crawley","address":{"@type":"PostalAddress","addressLocality":"Crawley","addressRegion":"West Sussex","addressCountry":"GB","postalCode":"RH10 1BN"},"geo":{"@type":"GeoCoordinates","latitude":51.1092,"longitude":-0.1872},"parentOrganization":{"@type":"Organization","name":"Specsavers Optical Group","url":"https://www.specsavers.co.uk"},"priceRange":"Free NHS / From £25 private","openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"17:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"09:00","closes":"17:00"}],"areaServed":{"@type":"City","name":"Crawley"}}4:Tfbf,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Why can't I book a Specsavers eye test through eyetest.co.uk?","acceptedAnswer":{"@type":"Answer","text":"Specsavers is not currently available for online booking through eyetest.co.uk. However, there are 9 excellent alternative opticians in Crawley that you can book with instantly, including Boots Opticians, ASDA Opticians, Leightons Opticians & Hearing Care."}},{"@type":"Question","name":"Are there alternatives to Specsavers in Crawley?","acceptedAnswer":{"@type":"Answer","text":"Yes! Crawley has 9 opticians available to book online right now. These include both well-known high-street brands and trusted independent practices. Many offer the same services as Specsavers, often with shorter waiting times and more personal service."}},{"@type":"Question","name":"How do I book an eye test in Crawley?","acceptedAnswer":{"@type":"Answer","text":"Enter the postcode RH10 1BN on eyetest.co.uk to see all available opticians in the Crawley area. You can compare prices, services, and appointment availability, then book online in seconds. Both NHS and private eye tests are available."}},{"@type":"Question","name":"How long does an eye test take?","acceptedAnswer":{"@type":"Answer","text":"A standard eye test typically takes between 20 and 30 minutes at most opticians in Crawley. Enhanced examinations with OCT scanning take around 35 to 45 minutes. Contact lens consultations may take 30 to 45 minutes. Allow extra time if you want to browse frames afterwards."}},{"@type":"Question","name":"Can I get a free NHS eye test in Crawley?","acceptedAnswer":{"@type":"Answer","text":"Yes, many opticians in Crawley offer free NHS-funded eye tests for eligible patients. You qualify if you are under 16, over 60, on certain benefits, or have specific medical conditions such as diabetes or glaucoma. In Scotland, all residents qualify for free NHS eye tests."}},{"@type":"Question","name":"Do I need to bring anything to my eye test?","acceptedAnswer":{"@type":"Answer","text":"Bring your current glasses or contact lenses, any NHS exemption evidence if applicable, and a list of medications you take. If you have a previous prescription from another optician, that can be useful for comparison. Arrive a few minutes early to complete any registration forms."}},{"@type":"Question","name":"Do independent opticians offer the same tests as Specsavers?","acceptedAnswer":{"@type":"Answer","text":"Yes. Independent and smaller-chain opticians use the same professional equipment and follow the same clinical standards as Specsavers. Many actually invest in more advanced diagnostic technology like OCT scanning. All optometrists in the UK are regulated by the General Optical Council to the same standards regardless of where they practise."}},{"@type":"Question","name":"How much do eye tests cost at alternatives to Specsavers in Crawley?","acceptedAnswer":{"@type":"Answer","text":"Eye test prices at alternative opticians in Crawley typically range from free (NHS-funded) to around £39 for a private examination. Many offer free NHS eye tests for eligible patients. Compare prices across all available opticians on eyetest.co.uk."}},{"@type":"Question","name":"Can children have eye tests in Crawley?","acceptedAnswer":{"@type":"Answer","text":"Yes, all opticians in Crawley offer eye tests for children. All children under 16 qualify for free NHS-funded eye tests. Optometrists use child-friendly techniques including picture charts and matching games for younger children. Regular eye tests are recommended annually for all school-age children."}},{"@type":"Question","name":"Is Specsavers in Crawley permanently closed?","acceptedAnswer":{"@type":"Answer","text":"Specsavers stores in Crawley may still be open for walk-in appointments. However, online booking through eyetest.co.uk is not currently available for Specsavers. We recommend trying one of the 9 alternative opticians in Crawley that offer instant online booking."}}]}0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.eyetest.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Opticians\",\"item\":\"https://www.eyetest.co.uk/opticians\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Specsavers Optical Group\",\"item\":\"https://www.eyetest.co.uk/opticians/specsavers\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Crawley\",\"item\":\"https://www.eyetest.co.uk/opticians/specsavers/crawley\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$3"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$4"}}],"$L5","$L6","$L7","$L8"]}],"$L9"],["$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"ssq08EaNRRySny1_GDRUp"}
