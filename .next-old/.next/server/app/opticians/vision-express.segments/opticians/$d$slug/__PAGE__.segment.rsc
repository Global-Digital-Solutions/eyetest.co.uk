lth."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"From £30"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"25-30 minutes"}]]}]]}],["$","div","2",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Advanced Eye Health Check with OCT"}],false]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"Vision Express's most thorough eye examination, combining a standard eye test with OCT (Optical Coherence Tomography) scanning and digital retinal photography. The OCT scan creates a detailed 3D map of the layers of the retina and optic nerve, while retinal photography provides a high-resolution colour image of the back of the eye. Together, these technologies enable early detection of conditions including macular degeneration, glaucoma, and diabetic retinopathy."}],["$","div",null,{"className":"flex items-center gap-4 text-sm","children":[["$","span",null,{"className":"font-semibold text-[var(--color-navy)]","children":"From £49"}],["$","span",null,{"className":"text-gray-400","children":"|"}],["$","span",null,{"className":"text-gray-500","children":"35-40 minutes"}]]}]]}],["$","div","3",{"className":"bg-white rounded-xl border border-gray-200 p-5","children":[["$","div",null,{"className":"flex items-start justify-between mb-3","children":[["$","h4",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"Contact Lens Fitting"}],false]}],["$","p",null,{"className":"text-sm text-gray-500 mb-3","children":"A specialist appointment to assess your suitability for contact lenses and find the best lens type for your needs. Includes corneal curvature measurements, tea