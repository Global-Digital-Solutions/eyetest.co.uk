2b:["$","tr","2",{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-medium text-[var(--color-navy)]","children":"Advanced Eye Health Check with OCT"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"Vision Express's most thorough eye examination, combining a standard eye test with OCT (Optical Coherence Tomography) scanning and digital retinal photography. The OCT scan creates a detailed 3D map of the layers of the retina and optic nerve, while retinal photography provides a high-resolution colour image of the back of the eye. Together, these technologies enable early detection of conditions including macular degeneration, glaucoma, and diabetic retinopathy."}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm font-semibold text-[var(--color-navy)]","children":"From £49"}]}],["$","td",null,{"className":"px-6 py-4","children":["$","span",null,{"className":"text-sm text-gray-500","children":"35-40 minutes"}]}],["$","td",null,{"className":"px-6 py-4 text-center","children":["$","span",null,{"className":"inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100","children":["$","svg",null,{"className":"w-4 h-4 text-gray-400","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"fillRule":"evenodd","d":"M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z","clipRule":"evenodd"}]}]}]}]]}]
